{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScannyBoyEvent",
  "description": "One line of stdout emitted by the scanny-boy CLI. See CONTRACT.md.",
  "type": "object",
  "definitions": {
    "eventType": {
      "type": "string",
      "enum": [
        "started",
        "probe_result",
        "progress",
        "item_done",
        "group_done",
        "group_failed",
        "warning",
        "error",
        "finished",
        "negative_done",
        "negative_failed",
        "roll_created",
        "roll_list",
        "roll_info",
        "roll_renamed",
        "metadata_applied",
        "metadata_skipped",
        "edit_recorded",
        "negative_deleted",
        "export_done",
        "flatfield_created",
        "flatfield_list",
        "flatfield_deleted"
      ]
    },
    "stage": {
      "type": "string",
      "description": "Which pipeline stage a progress event describes.",
      "enum": ["convert", "stitch"]
    },
    "pipelineStep": {
      "type": "string",
      "description": "One pipeline step, per the Vocabulary section of the implementation plan.",
      "enum": [
        "decode",
        "write_tiff",
        "add_metadata",
        "load",
        "detect",
        "match",
        "solve",
        "warp",
        "blend",
        "write_stitched"
      ]
    },
    "code": {
      "type": "string",
      "description": "A stable error or warning code from CONTRACT.md.",
      "enum": [
        "NO_FILES",
        "NON_CONTIGUOUS_SELECTION",
        "NOT_DIVISIBLE",
        "INVALID_PER_NEGATIVE",
        "MISSING_CAPTURE_TIME",
        "FILENAME_SORT_USED",
        "UNSUPPORTED_RAW",
        "CAPTURE_METADATA_MISSING",
        "CAPTURE_SETTINGS_DIFFER",
        "UNREADABLE_RAW",
        "OUTPUT_SAME_AS_INPUT",
        "OUTPUT_NOT_WRITABLE",
        "OUTPUT_NOT_EMPTY",
        "OUTPUT_CONFLICT",
        "INSUFFICIENT_DISK",
        "INSUFFICIENT_MEMORY",
        "BAD_MANIFEST",
        "MANIFEST_MISMATCH",
        "ICC_PROFILE_INVALID",
        "TIFF_WRITE_FAILED",
        "CANCELLED",
        "WORK_SAME_AS_OUTPUT",
        "WORK_MANIFEST_UNUSABLE",
        "INTERMEDIATE_MISSING",
        "INTERMEDIATE_CHANGED",
        "STITCH_INSUFFICIENT_MATCHES",
        "STITCH_UNDERCONSTRAINED",
        "STITCH_RESIDUAL_TOO_HIGH",
        "STITCH_OUTPUT_TOO_LARGE",
        "STITCH_FAILED",
        "STITCH_SCALE_DRIFT",
        "STITCH_GAIN_DRIFT",
        "STITCH_LAYOUT_UNEXPECTED",
        "STITCH_REBATE_CHECK_FAILED",
        "STITCH_CLAHE_FALLBACK_USED",
        "OUTPUT_DIMENSIONS_LARGE",
        "INTERMEDIATES_KEPT",
        "ROLL_NOT_FOUND",
        "ROLL_MANIFEST_UNSUPPORTED",
        "ROLL_EXISTS",
        "ROLL_RENAME_FAILED",
        "ROLL_INVARIANT_MISMATCH",
        "PER_NEGATIVE_LOCKED",
        "OUTPUT_MODIFIED_EXTERNALLY",
        "METADATA_WRITE_FAILED",
        "ORPHAN_FILE_NOT_REMOVED",
        "NEGATIVE_NOT_FOUND",
        "INVALID_EDIT",
        "EXPORT_FAILED",
        "PREVIEW_FAILED",
        "FLATFIELD_PROFILE_NOT_FOUND",
        "FLATFIELD_PROFILE_EXISTS",
        "FLATFIELD_PROFILE_IN_USE",
        "FLATFIELD_GAIN_MAP_MISSING",
        "FLATFIELD_ASPECT_MISMATCH",
        "FLATFIELD_HIGHLIGHT_CLIPPED",
        "LIBRARY_DB_UNSUPPORTED",
        "INTERNAL_ERROR"
      ]
    },
    "rollOverlapEntry": {
      "type": "object",
      "required": [
        "negative_id",
        "expected_output",
        "run_id",
        "overlapping_sources",
        "group_index"
      ],
      "properties": {
        "negative_id": { "type": "string" },
        "expected_output": { "type": "string" },
        "run_id": { "type": "string" },
        "overlapping_sources": {
          "type": "array",
          "items": { "type": "string" }
        },
        "group_index": { "type": "integer", "minimum": 0 }
      }
    },
    "rollListingReason": {
      "type": "object",
      "required": ["code", "message"],
      "properties": {
        "code": { "type": "string" },
        "message": { "type": "string" }
      }
    },
    "flatFieldProfile": {
      "type": "object",
      "required": [
        "profile_id",
        "name",
        "reference_width",
        "reference_height",
        "source_path",
        "created_at"
      ],
      "properties": {
        "profile_id": { "type": "string" },
        "name": { "type": "string" },
        "reference_width": { "type": "integer", "minimum": 1 },
        "reference_height": { "type": "integer", "minimum": 1 },
        "source_path": { "type": ["string", "null"] },
        "created_at": { "type": "string" }
      }
    },
    "rollListingEntry": {
      "type": "object",
      "required": ["path", "status", "reason", "roll_id", "roll_name", "negative_count"],
      "properties": {
        "path": { "type": "string" },
        "status": { "type": "string", "enum": ["ok", "unreadable"] },
        "reason": {
          "oneOf": [{ "$ref": "#/definitions/rollListingReason" }, { "type": "null" }]
        },
        "roll_id": { "type": ["string", "null"] },
        "roll_name": { "type": ["string", "null"] },
        "negative_count": { "type": ["integer", "null"], "minimum": 0 }
      }
    }
  },
  "required": ["protocol_version", "event"],
  "properties": {
    "protocol_version": {
      "type": "integer",
      "const": 6
    },
    "event": { "$ref": "#/definitions/eventType" },
    "run_id": {
      "type": "string",
      "description": "Present when the event belongs to a conversion run."
    }
  },
  "allOf": [
    {
      "if": { "properties": { "event": { "const": "progress" } } },
      "then": {
        "required": ["source_index", "step", "completed", "total", "stage"],
        "properties": {
          "source_index": { "type": "integer", "minimum": 0 },
          "step": { "$ref": "#/definitions/pipelineStep" },
          "completed": { "type": "integer", "minimum": 0 },
          "total": { "type": "integer", "minimum": 0 },
          "stage": { "$ref": "#/definitions/stage" }
        }
      }
    },
    {
      "if": { "properties": { "event": { "const": "negative_done" } } },
      "then": {
        "required": [
          "negative_id",
          "output",
          "width",
          "height",
          "global_rms_px",
          "max_overlap_mad"
        ],
        "properties": {
          "negative_id": { "type": "string" },
          "output": { "type": "string" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 },
          "global_rms_px": { "type": "number" },
          "max_overlap_mad": { "type": "number" }
        }
      }
    },
    {
      "if": { "properties": { "event": { "const": "negative_failed" } } },
      "then": {
        "required": ["negative_id", "code", "message"],
        "properties": {
          "negative_id": { "type": "string" },
          "code": { "$ref": "#/definitions/code" },
          "message": { "type": "string" }
        }
      }
    },
    {
      "if": { "properties": { "event": { "const": "error" } } },
      "then": {
        "required": ["code", "message"],
        "properties": {
          "code": { "$ref": "#/definitions/code" },
          "message": { "type": "string" }
        }
      }
    },
    {
      "if": { "properties": { "event": { "const": "warning" } } },
      "then": {
        "required": ["code", "message"],
        "properties": {
          "code": { "$ref": "#/definitions/code" },
          "message": { "type": "string" }
        }
      }
    },
    {
      "if": { "properties": { "event": { "const": "probe_result" } } },
      "then": {
        "required": ["catalogue", "warnings"],
        "properties": {
          "catalogue": { "type": "array", "items": { "type": "string" } },
          "warnings": { "type": "array", "items": { "type": "string" } },
          "groups": {
            "type": "array",
            "items": { "type": "array", "items": { "type": "string" } }
          },
          "output_conflicts": { "type": "array", "items": { "type": "string" } },
          "estimated_required_bytes": { "type": ["integer", "null"] },
          "available_bytes": { "type": ["integer", "null"] },
          "roll_overlap": {
            "type": "array",
            "items": { "$ref": "#/definitions/rollOverlapEntry" }
          }
        }
      }
    },
    {
      "if": { "properties": { "event": { "const": "started" } } },
      "then": {
        "required": ["command"],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "probe",
              "convert",
              "stitch",
              "run",
              "roll init",
              "roll list",
              "roll info",
              "roll rename",
              "apply-metadata",
              "edit rotate",
              "edit delete",
              "export",
              "flatfield create",
              "flatfield list",
              "flatfield delete"
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "event": { "const": "finished" } } },
      "then": {
        "required": ["status", "exit_status"],
        "properties": {
          "status": { "type": "string" },
          "exit_status": { "type": "integer" }
        }
      }
    },
    {
      "if": { "properties": { "event": { "const": "roll_created" } } },
      "then": {
        "required": ["roll_id", "roll_name", "path"],
        "properties": {
          "roll_id": { "type": "string" },
          "roll_name": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    },
    {
      "if": { "properties": { "event": { "const": "roll_list" } } },
      "then": {
        "required": ["rolls"],
        "properties": {
          "rolls": {
            "type": "array",
            "items": { "$ref": "#/definitions/rollListingEntry" }
          }
        }
      }
    },
    {
      "if": { "properties": { "event": { "const": "roll_info" } } },
      "then": {
        "required": ["manifest"],
        "properties": {
          "manifest": { "type": "object" }
        }
      }
    },
    {
      "if": { "properties": { "event": { "const": "roll_renamed" } } },
      "then": {
        "required": ["roll_id", "roll_name", "path"],
        "properties": {
          "roll_id": { "type": "string" },
          "roll_name": { "type": "string" },
          "path": { "type": "string" }
        }
      }
    },
    {
      "if": { "properties": { "event": { "const": "metadata_applied" } } },
      "then": {
        "required": ["negative_id"],
        "properties": {
          "negative_id": { "type": "string" }
        }
      }
    },
    {
      "if": { "properties": { "event": { "const": "metadata_skipped" } } },
      "then": {
        "required": ["negative_id", "code", "message"],
        "properties": {
          "negative_id": { "type": "string" },
          "code": { "$ref": "#/definitions/code" },
          "message": { "type": "string" }
        }
      }
    },
    {
      "if": { "properties": { "event": { "const": "edit_recorded" } } },
      "then": {
        "required": ["negative_id", "edit", "rotation_quarter_turns", "preview_path"],
        "properties": {
          "negative_id": { "type": "string" },
          "edit": {
            "type": "object",
            "required": ["id", "negative_id", "position", "op", "params", "created_at"],
            "properties": {
              "id": { "type": "integer", "minimum": 1 },
              "negative_id": { "type": "string" },
              "position": { "type": "integer", "minimum": 1 },
              "op": { "type": "string" },
              "params": { "type": "object" },
              "created_at": { "type": "string" }
            }
          },
          "rotation_quarter_turns": { "type": "integer", "minimum": 0, "maximum": 3 },
          "preview_path": { "type": ["string", "null"] }
        }
      }
    },
    {
      "if": { "properties": { "event": { "const": "flatfield_created" } } },
      "then": {
        "required": ["profile"],
        "properties": {
          "profile": { "$ref": "#/definitions/flatFieldProfile" }
        }
      }
    },
    {
      "if": { "properties": { "event": { "const": "flatfield_list" } } },
      "then": {
        "required": ["profiles"],
        "properties": {
          "profiles": {
            "type": "array",
            "items": { "$ref": "#/definitions/flatFieldProfile" }
          }
        }
      }
    },
    {
      "if": { "properties": { "event": { "const": "flatfield_deleted" } } },
      "then": {
        "required": ["profile_id"],
        "properties": {
          "profile_id": { "type": "string" }
        }
      }
    },
    {
      "if": { "properties": { "event": { "const": "negative_deleted" } } },
      "then": {
        "required": ["negative_id", "output"],
        "properties": {
          "negative_id": { "type": "string" },
          "output": { "type": ["string", "null"] }
        }
      }
    },
    {
      "if": { "properties": { "event": { "const": "export_done" } } },
      "then": {
        "required": ["negative_id", "output", "width", "height"],
        "properties": {
          "negative_id": { "type": "string" },
          "output": { "type": "string" },
          "width": { "type": "integer", "minimum": 1 },
          "height": { "type": "integer", "minimum": 1 }
        }
      }
    }
  ]
}
