{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScannyBoyRollManifest",
  "description": "scanny-boy-roll.json: one roll's durable record. See docs/PHASE3_IMPLEMENTATION_PLAN.md section 3.3.",
  "type": "object",
  "definitions": {
    "runStatus": {
      "type": "string",
      "enum": ["running", "partial", "cancelled", "complete"]
    },
    "negativeStatus": {
      "type": "string",
      "enum": ["pending", "completed", "failed"]
    },
    "runKind": {
      "type": "string",
      "enum": ["run", "stitch"]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "required": ["filename", "absolute_path", "size", "mtime", "sha256", "run_id"],
      "properties": {
        "filename": { "type": "string" },
        "absolute_path": { "type": "string" },
        "size": { "type": "integer", "minimum": 0 },
        "mtime": { "type": "number" },
        "sha256": { "$ref": "#/definitions/sha256" },
        "run_id": { "type": "string" },
        "scan_clip_fractions": {
          "type": ["array", "null"],
          "items": { "type": "number", "minimum": 0.0, "maximum": 1.0 },
          "minItems": 3,
          "maxItems": 3,
          "description": "Per-channel fraction of pixels at or above sensor white, measured in the prepare stage at decode; null when the contributing run predates the measurement."
        }
      }
    },
    "iccProfile": {
      "type": "object",
      "required": ["name", "sha256"],
      "properties": {
        "name": { "type": "string" },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "output": {
      "type": "object",
      "required": ["name", "size", "sha256", "width", "height"],
      "properties": {
        "name": { "type": "string" },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/definitions/sha256" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "frame": {
      "type": "object",
      "required": ["name", "rotation_deg", "translation", "gain", "scale"],
      "properties": {
        "name": { "type": "string" },
        "rotation_deg": { "type": "number" },
        "translation": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        },
        "gain": {
          "type": "array",
          "items": { "type": "number", "exclusiveMinimum": 0 },
          "minItems": 3,
          "maxItems": 3
        },
        "scale": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "pair": {
      "type": "object",
      "required": [
        "a",
        "b",
        "inliers",
        "good_matches",
        "inlier_ratio",
        "rms_residual_px",
        "scale_drift",
        "overlap_fraction",
        "overlap_mad",
        "overlap_mad_pregain",
        "accepted"
      ],
      "properties": {
        "a": { "type": "string" },
        "b": { "type": "string" },
        "inliers": { "type": "integer", "minimum": 0 },
        "good_matches": { "type": "integer", "minimum": 0 },
        "inlier_ratio": { "type": "number" },
        "rms_residual_px": { "type": "number" },
        "scale_drift": { "type": "number" },
        "overlap_fraction": { "type": ["number", "null"] },
        "overlap_mad": { "type": ["number", "null"] },
        "overlap_mad_pregain": { "type": ["number", "null"] },
        "accepted": { "type": "boolean" }
      }
    },
    "normalization": {
      "type": "object",
      "required": [
        "floors",
        "ceils",
        "shadow_refs",
        "anchor",
        "textural_range",
        "analysis_rect",
        "observed_min",
        "observed_max",
        "headroom_clipped_highlights",
        "headroom_clipped_shadows",
        "rebate",
        "source"
      ],
      "properties": {
        "floors": {
          "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3
        },
        "ceils": {
          "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3
        },
        "shadow_refs": {
          "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3
        },
        "anchor": { "type": "number" },
        "textural_range": { "type": "number" },
        "analysis_rect": {
          "type": "array", "items": { "type": "integer" }, "minItems": 4, "maxItems": 4
        },
        "observed_min": {
          "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3
        },
        "observed_max": {
          "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3
        },
        "headroom_clipped_highlights": {
          "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3
        },
        "headroom_clipped_shadows": {
          "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3
        },
        "rebate": {
          "type": "object",
          "required": ["detected", "mask_fraction", "base_density", "clipped"],
          "properties": {
            "detected": { "type": "boolean" },
            "mask_fraction": { "type": "number" },
            "base_density": {
              "oneOf": [
                {
                  "type": "array",
                  "items": { "type": "number" },
                  "minItems": 3,
                  "maxItems": 3
                },
                { "type": "null" }
              ]
            },
            "clipped": { "type": "boolean" }
          }
        },
        "dense_border": {
          "type": "object",
          "required": ["detected", "mask_fraction"],
          "properties": {
            "detected": { "type": "boolean" },
            "mask_fraction": { "type": "number" }
          }
        },
        "clamped": { "type": "boolean" },
        "unclamped_floors": {
          "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3
        },
        "unclamped_ceils": {
          "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3
        },
        "source": { "type": "string" }
      }
    },
    "negativeMetadata": {
      "type": "object",
      "required": ["city", "state", "camera", "lens", "caption"],
      "properties": {
        "city": { "type": ["string", "null"] },
        "state": { "type": ["string", "null"] },
        "camera": { "type": ["string", "null"] },
        "lens": { "type": ["string", "null"] },
        "caption": { "type": ["string", "null"] }
      },
      "additionalProperties": false,
      "description": "The negative's explicit extended-metadata values; null means inherit the roll-level fallback."
    },
    "captureTime": {
      "type": "object",
      "required": [
        "source_datetime_original",
        "intended_datetime_original",
        "applied_datetime_original",
        "date_override"
      ],
      "properties": {
        "source_datetime_original": { "type": ["string", "null"] },
        "intended_datetime_original": { "type": ["string", "null"] },
        "applied_datetime_original": { "type": ["string", "null"] },
        "date_override": { "type": ["string", "null"] }
      }
    },
    "run": {
      "type": "object",
      "required": [
        "run_id",
        "short_id",
        "kind",
        "status",
        "convert_run_id",
        "input_folder",
        "source_order",
        "work_dir",
        "started_at",
        "finished_at"
      ],
      "properties": {
        "run_id": { "type": "string" },
        "short_id": { "type": "string" },
        "kind": { "$ref": "#/definitions/runKind" },
        "status": { "$ref": "#/definitions/runStatus" },
        "convert_run_id": { "type": ["string", "null"] },
        "input_folder": { "type": ["string", "null"] },
        "source_order": {
          "type": "array",
          "items": { "type": "string" }
        },
        "work_dir": { "type": ["string", "null"] },
        "started_at": { "type": "string" },
        "finished_at": { "type": ["string", "null"] },
        "normalization_aggregate": {
          "oneOf": [{ "type": "object" }, { "type": "null" }],
          "description": "D-4: the per-channel median of the run's negatives' bounds; recorded, nothing reads it yet."
        }
      }
    },
    "negative": {
      "type": "object",
      "required": [
        "negative_id",
        "run_id",
        "sequence",
        "members",
        "expected_output",
        "status",
        "output",
        "frames",
        "pairs",
        "global_rms_px",
        "canvas",
        "valid_rect",
        "fill_color",
        "rebate_deviation_px",
        "used_clahe_fallback",
        "error_code",
        "error_message",
        "capture_time",
        "metadata",
        "preview_path",
        "normalized_fill",
        "normalization"
      ],
      "properties": {
        "negative_id": { "type": "string" },
        "run_id": { "type": "string" },
        "sequence": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "Rank among completed negatives; null while unranked (pending/failed)."
        },
        "members": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "expected_output": { "type": "string" },
        "status": { "$ref": "#/definitions/negativeStatus" },
        "output": {
          "oneOf": [{ "$ref": "#/definitions/output" }, { "type": "null" }]
        },
        "frames": {
          "type": "array",
          "items": { "$ref": "#/definitions/frame" }
        },
        "pairs": {
          "type": "array",
          "items": { "$ref": "#/definitions/pair" }
        },
        "global_rms_px": { "type": ["number", "null"] },
        "canvas": {
          "oneOf": [
            {
              "type": "object",
              "required": ["width", "height"],
              "properties": {
                "width": { "type": "integer", "minimum": 1 },
                "height": { "type": "integer", "minimum": 1 }
              }
            },
            { "type": "null" }
          ]
        },
        "valid_rect": {
          "oneOf": [
            {
              "type": "array",
              "items": { "type": "integer" },
              "minItems": 4,
              "maxItems": 4
            },
            { "type": "null" }
          ]
        },
        "fill_color": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 255 },
          "minItems": 3,
          "maxItems": 3
        },
        "rebate_deviation_px": { "type": ["number", "null"] },
        "used_clahe_fallback": { "type": "boolean" },
        "error_code": { "type": ["string", "null"] },
        "error_message": { "type": ["string", "null"] },
        "capture_time": { "$ref": "#/definitions/captureTime" },
        "metadata": { "$ref": "#/definitions/negativeMetadata" },
        "preview_path": {
          "type": ["string", "null"],
          "description": "CLI-generated preview of the negative as its edits render so far; null until first generated."
        },
        "normalized_fill": {
          "type": ["number", "null"],
          "description": "Section 3.14's uncovered-canvas fill value, recorded so a file is interpretable without knowing which build wrote it."
        },
        "normalization": {
          "oneOf": [{ "$ref": "#/definitions/normalization" }, { "type": "null" }]
        },
        "rotation_quarter_turns": {
          "type": ["integer", "null"],
          "minimum": 0,
          "maximum": 3,
          "description": "Derived, not stored: present in `roll info` output only — the ops log's net clockwise quarter turns."
        },
        "flipped_horizontally": {
          "type": ["boolean", "null"],
          "description": "Derived, not stored: present in `roll info` output only — whether the ops log's net transform includes a horizontal mirror."
        }
      }
    },
    "metadata": {
      "type": "object",
      "required": [
        "roll_capture_date",
        "last_applied_at",
        "city",
        "state",
        "camera",
        "lens",
        "caption"
      ],
      "properties": {
        "roll_capture_date": {
          "type": ["string", "null"],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "last_applied_at": { "type": ["string", "null"] },
        "city": { "type": ["string", "null"] },
        "state": { "type": ["string", "null"] },
        "camera": { "type": ["string", "null"] },
        "lens": { "type": ["string", "null"] },
        "caption": { "type": ["string", "null"] }
      },
      "additionalProperties": false
    }
  },
  "required": [
    "manifest_format_version",
    "manifest_kind",
    "scanny_boy_version",
    "roll_id",
    "roll_name",
    "created_at",
    "updated_at",
    "processing_params",
    "icc_profile",
    "published_icc_profile",
    "stitch_params",
    "runs",
    "sources",
    "negatives",
    "metadata"
  ],
  "properties": {
    "manifest_format_version": { "type": "integer", "const": 6 },
    "manifest_kind": { "type": "string", "const": "roll" },
    "scanny_boy_version": { "type": "string" },
    "roll_id": { "type": "string" },
    "roll_name": { "type": "string" },
    "created_at": { "type": "string" },
    "updated_at": { "type": "string" },
    "processing_params": { "type": "object" },
    "icc_profile": { "$ref": "#/definitions/iccProfile" },
    "published_icc_profile": {
      "allOf": [{ "$ref": "#/definitions/iccProfile" }],
      "description": "The density profile the published TIFFs carry (docs/DECISIONS.md, \"Normalization decisions\")."
    },
    "stitch_params": { "type": "object" },
    "runs": {
      "type": "array",
      "items": { "$ref": "#/definitions/run" }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/definitions/source" }
    },
    "negatives": {
      "type": "array",
      "items": { "$ref": "#/definitions/negative" }
    },
    "metadata": { "$ref": "#/definitions/metadata" }
  }
}
