{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ScannyBoyRollManifest",
  "description": "scanny-boy-roll.json: the output folder's record of one stitched roll. See docs/PHASE2_IMPLEMENTATION_PLAN.md section 3.7.",
  "type": "object",
  "definitions": {
    "status": {
      "type": "string",
      "enum": ["running", "partial", "cancelled", "complete"]
    },
    "negativeStatus": {
      "type": "string",
      "enum": ["pending", "completed", "failed"]
    },
    "sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "source": {
      "type": "object",
      "required": ["filename", "absolute_path", "size", "mtime", "sha256"],
      "properties": {
        "filename": { "type": "string" },
        "absolute_path": { "type": "string" },
        "size": { "type": "integer", "minimum": 0 },
        "mtime": { "type": "number" },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "iccProfile": {
      "type": "object",
      "required": ["name", "sha256"],
      "properties": {
        "name": { "type": "string" },
        "sha256": { "$ref": "#/definitions/sha256" }
      }
    },
    "output": {
      "type": "object",
      "required": ["name", "size", "sha256", "width", "height"],
      "properties": {
        "name": { "type": "string" },
        "size": { "type": "integer", "minimum": 0 },
        "sha256": { "$ref": "#/definitions/sha256" },
        "width": { "type": "integer", "minimum": 1 },
        "height": { "type": "integer", "minimum": 1 }
      }
    },
    "frame": {
      "type": "object",
      "required": ["name", "rotation_deg", "translation"],
      "properties": {
        "name": { "type": "string" },
        "rotation_deg": { "type": "number" },
        "translation": {
          "type": "array",
          "items": { "type": "number" },
          "minItems": 2,
          "maxItems": 2
        }
      }
    },
    "pair": {
      "type": "object",
      "required": [
        "a",
        "b",
        "inliers",
        "good_matches",
        "inlier_ratio",
        "rms_residual_px",
        "scale_drift",
        "overlap_fraction",
        "overlap_mad",
        "accepted"
      ],
      "properties": {
        "a": { "type": "string" },
        "b": { "type": "string" },
        "inliers": { "type": "integer", "minimum": 0 },
        "good_matches": { "type": "integer", "minimum": 0 },
        "inlier_ratio": { "type": "number" },
        "rms_residual_px": { "type": "number" },
        "scale_drift": { "type": "number" },
        "overlap_fraction": { "type": ["number", "null"] },
        "overlap_mad": { "type": ["number", "null"] },
        "accepted": { "type": "boolean" }
      }
    },
    "negative": {
      "type": "object",
      "required": [
        "negative_id",
        "members",
        "expected_output",
        "status",
        "output",
        "frames",
        "pairs",
        "global_rms_px",
        "canvas",
        "valid_rect",
        "fill_color",
        "rebate_deviation_px",
        "error_code",
        "error_message"
      ],
      "properties": {
        "negative_id": { "type": "string" },
        "members": {
          "type": "array",
          "items": { "type": "string" },
          "minItems": 1
        },
        "expected_output": { "type": "string" },
        "status": { "$ref": "#/definitions/negativeStatus" },
        "output": {
          "oneOf": [{ "$ref": "#/definitions/output" }, { "type": "null" }]
        },
        "frames": {
          "type": "array",
          "items": { "$ref": "#/definitions/frame" }
        },
        "pairs": {
          "type": "array",
          "items": { "$ref": "#/definitions/pair" }
        },
        "global_rms_px": { "type": ["number", "null"] },
        "canvas": {
          "oneOf": [
            {
              "type": "object",
              "required": ["width", "height"],
              "properties": {
                "width": { "type": "integer", "minimum": 1 },
                "height": { "type": "integer", "minimum": 1 }
              }
            },
            { "type": "null" }
          ]
        },
        "valid_rect": {
          "oneOf": [
            {
              "type": "array",
              "items": { "type": "integer" },
              "minItems": 4,
              "maxItems": 4
            },
            { "type": "null" }
          ]
        },
        "fill_color": {
          "type": "array",
          "items": { "type": "integer", "minimum": 0, "maximum": 255 },
          "minItems": 3,
          "maxItems": 3
        },
        "rebate_deviation_px": { "type": ["number", "null"] },
        "error_code": { "type": ["string", "null"] },
        "error_message": { "type": ["string", "null"] }
      }
    }
  },
  "required": [
    "manifest_format_version",
    "manifest_kind",
    "scanny_boy_version",
    "run_id",
    "status",
    "input_folder",
    "film_date",
    "shots_per_negative",
    "convert_run_id",
    "processing_params",
    "icc_profile",
    "stitch_params",
    "source_order",
    "sources",
    "negatives",
    "started_at",
    "finished_at"
  ],
  "properties": {
    "manifest_format_version": { "type": "integer", "const": 1 },
    "manifest_kind": { "type": "string", "const": "stitch" },
    "scanny_boy_version": { "type": "string" },
    "run_id": { "type": "string" },
    "status": { "$ref": "#/definitions/status" },
    "input_folder": { "type": "string" },
    "film_date": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "shots_per_negative": { "type": "integer", "minimum": 1, "maximum": 12 },
    "convert_run_id": { "type": "string" },
    "processing_params": { "type": "object" },
    "icc_profile": { "$ref": "#/definitions/iccProfile" },
    "stitch_params": { "type": "object" },
    "source_order": {
      "type": "array",
      "items": { "type": "string" }
    },
    "sources": {
      "type": "array",
      "items": { "$ref": "#/definitions/source" }
    },
    "negatives": {
      "type": "array",
      "items": { "$ref": "#/definitions/negative" }
    },
    "started_at": { "type": "string" },
    "finished_at": { "type": ["string", "null"] }
  }
}
